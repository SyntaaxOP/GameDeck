{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Launch only the bundled GameDeck backend sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "autostart:default",
    "notification:default",
    { "identifier": "shell:allow-spawn", "allow": [{ "name": "binaries/gamedeck-api", "sidecar": true }] }
  ]
}
