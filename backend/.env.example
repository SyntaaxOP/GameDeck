# Copy to backend/.env for local overrides. Do not commit secrets.
GAMEDECK_LOG_LEVEL=INFO
GAMEDECK_SQL_ECHO=false
GAMEDECK_SQLITE_BUSY_TIMEOUT_MS=5000

# Optional examples:
# GAMEDECK_DATABASE_URL=sqlite:///C:/Users/you/AppData/Local/GameDeck/gamedeck.db
# GAMEDECK_LOG_DIR=C:/Users/you/AppData/Local/GameDeck/logs
# GAMEDECK_BACKUP_DIR=C:/Users/you/AppData/Local/GameDeck/backups
# GAMEDECK_ARTWORK_DIR=C:/Users/you/AppData/Local/GameDeck/artwork
# GAMEDECK_STEAM_PATH=D:/Apps/Steam
# GAMEDECK_STEAM_API_KEY=your-backend-only-key
# GAMEDECK_STEAM_ID=76561198000000000
